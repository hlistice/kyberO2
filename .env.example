# Zkopíruj do .env. Skutečný klíč nikdy neukládej do GitHubu ani do app.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
HOST=127.0.0.1
# Při hostování v kontejneru nastav HOST=0.0.0.0.
# Volitelný kompatibilní poskytovatel; musí podporovat vision a JSON schema.
# OPENAI_BASE_URL=https://api.openai.com/v1
